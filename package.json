{
  "name": "social-agent-ai",
  "version": "1.1.0",
  "description": "Open-source, self-hosted AI-powered social media automation platform with multi-platform publishing, analytics, and autonomous strategy optimization",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/server/views', 'dist/server/views', { recursive: true })\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.dev.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts"
  },
  "keywords": [
    "social-media",
    "social-media-automation",
    "ai",
    "gemini",
    "twitter",
    "instagram",
    "youtube",
    "tiktok",
    "content-generation",
    "scheduler",
    "self-hosted",
    "typescript"
  ],
  "author": "Yusuf Sizmaz (https://github.com/YusufSizmaz)",
  "homepage": "https://github.com/YusufSizmaz/social-agent-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YusufSizmaz/social-agent-ai.git"
  },
  "bugs": {
    "url": "https://github.com/YusufSizmaz/social-agent-ai/issues"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.0",
    "edge-tts-universal": "^1.4.0",
    "express": "^4.21.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^144.0.0",
    "multer": "^2.1.0",
    "node-cron": "^3.0.3",
    "p-queue": "^8.0.1",
    "pexels": "^1.4.0",
    "postgres": "^3.4.5",
    "twitter-api-v2": "^1.18.2",
    "whatsapp-web.js": "^1.26.0",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
