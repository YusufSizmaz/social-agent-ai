# ─────────────────────────────────────────────────────────────
#  Required
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (ignored by docker compose, which wires up its own database)
DATABASE_URL=postgresql://user:password@localhost:5432/social_media_bot

# Google Gemini API key — free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# ─────────────────────────────────────────────────────────────
#  Security
# ─────────────────────────────────────────────────────────────

# Protects the dashboard and REST API with HTTP Basic Auth.
# Strongly recommended for anything reachable from a network.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# ─────────────────────────────────────────────────────────────
#  Platforms — configure only the ones you use
# ─────────────────────────────────────────────────────────────

# Twitter / X (app credentials; user tokens can also be set per account in the dashboard)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_CALLBACK_URL=http://localhost:3000/api/twitter/callback

# Instagram Graph API (business account)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────
#  Optional
# ─────────────────────────────────────────────────────────────

# Public URL of this server. Instagram downloads media by URL, so locally
# generated images/videos need this to be publishable (e.g. https://bot.example.com)
PUBLIC_BASE_URL=

# Gemini models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# Score every generated post with Gemini; low scores are held for manual review
QUALITY_CHECK_ENABLED=false
QUALITY_MIN_SCORE=60

# Stock images used when AI image generation fails — free at https://www.pexels.com/api/
PEXELS_API_KEY=

# WhatsApp number (country code, no +) that receives notifications and reports
WHATSAPP_ADMIN_NUMBER=

# External database polled by the example CatPet plugin
PLUGIN_DATABASE_URL=

# Apply database migrations on startup (docker compose enables this by default)
RUN_MIGRATIONS=false

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
